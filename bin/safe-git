#!/usr/bin/env bash
set -euo pipefail

# Resolve this script's real directory (through any install symlink) so the
# canonical hooks can be located for install_hooks. Hooks live at ../hooks
# relative to bin/safe-git. Walk the symlink chain with plain `readlink` (no
# `-f`) for BSD/macOS portability — `readlink -f` is GNU-only, and falling back
# to the unresolved symlink path would point SAFE_GIT_HOOKS_DIR at the install
# dir (e.g. ~/.local/hooks) and silently disable hook install.
SAFE_GIT_SELF="${BASH_SOURCE[0]}"
while command -v readlink >/dev/null 2>&1 && [ -L "$SAFE_GIT_SELF" ]; do
  _link="$(readlink "$SAFE_GIT_SELF")"
  case "$_link" in
    /*) SAFE_GIT_SELF="$_link" ;;
    *)  SAFE_GIT_SELF="$(dirname "$SAFE_GIT_SELF")/$_link" ;;
  esac
done
SAFE_GIT_BIN_DIR="$(cd "$(dirname "$SAFE_GIT_SELF")" && pwd)"
SAFE_GIT_HOOKS_DIR="$(cd "$SAFE_GIT_BIN_DIR/../hooks" 2>/dev/null && pwd || true)"

# Strip ambient git env before the first git call (#1687/#1721). safe-git scopes
# nothing with `git -C` — it resolves the repository from the current directory —
# so a leaked GIT_DIR/GIT_WORK_TREE from a hook's temporary-index context or an
# exporting caller would silently point every gate, worktree creation, and branch
# deletion at a DIFFERENT repository. Source through the symlink-resolved
# SAFE_GIT_BIN_DIR, not `dirname "${BASH_SOURCE[0]}"`: safe-git is reached via a
# ~/.local/bin symlink, where the unresolved path would look for the shared lib
# under the install dir and miss it.
# Fail LOUD, not silent: a safety tool that manages worktrees and deletes
# branches must not run against a repository chosen by inherited env. But the
# bare `.` under `set -e` aborts with a raw "No such file or directory", which
# is unactionable — reachable when the symlink chain cannot be walked (no
# `readlink`), the case SAFE_GIT_HOOKS_DIR above deliberately degrades on.
_safe_git_gitenv="$SAFE_GIT_BIN_DIR/../lib/gitenv.sh"
if [ -r "$_safe_git_gitenv" ]; then
  # shellcheck source=../lib/gitenv.sh
  . "$_safe_git_gitenv"
  scrub_git_env
else
  # Shared lib unreachable — reachable when the symlink chain cannot be walked
  # (no `readlink`), the same case SAFE_GIT_HOOKS_DIR above degrades on. Neither
  # running unscrubbed nor refusing outright is right: refusing bricks a tool the
  # whole ticket workflow depends on, over a condition unrelated to whether any
  # git env is actually leaking. Derive the strip from Git's own
  # `rev-parse --local-env-vars` contract instead — that is the same source of
  # truth the shared list is built from, not a second hand-kept copy — plus the
  # three discovery/namespace names the shared list adds beyond it.
  _safe_git_local_vars="$(git rev-parse --local-env-vars 2>/dev/null || true)"
  if [ -z "$_safe_git_local_vars" ]; then
    # Cannot enumerate the list, so cannot promise a scrub. Refuse rather than
    # continue: unsetting only the three extras below would leave GIT_DIR,
    # GIT_WORK_TREE and GIT_OBJECT_DIRECTORY live, which is exactly the leak this
    # tool must never operate under — worse than not starting.
    printf 'safe-git: BLOCKED: shared git-env strip unreadable at %s, and `git rev-parse --local-env-vars` produced nothing.\n' "$_safe_git_gitenv" >&2
    printf 'safe-git: refusing to run unscrubbed — an inherited GIT_DIR would repoint every gate, worktree and branch operation at another repository.\n' >&2
    exit 1
  fi
  # shellcheck disable=SC2086 # word splitting is the point: one unset arg per var name
  unset $_safe_git_local_vars
  unset GIT_CEILING_DIRECTORIES GIT_DISCOVERY_ACROSS_FILESYSTEM GIT_NAMESPACE
fi

usage() {
  /usr/bin/env cat <<'EOF'
Usage:
  safe-git worktree start <path> -b <branch> --purpose <text> [--base <ref>] [--issue <id>] [--title <text>] [--ticket-source <github|local>] [--no-fetch]
  safe-git worktree adopt <path> --purpose <text> [--base <ref>] [--issue <id>] [--title <text>] [--no-fetch]
  safe-git worktree plan-id [--bind]
  safe-git check start [--read-only] [--no-fetch]
  safe-git check pr
  safe-git check done
  safe-git check plan-done [--resume-branch <branch> --ticket-source <github|local> --ticket-id <id>]

`worktree start` creates an isolated linked worktree and records why it
exists in the repo's local git metadata.
`worktree adopt` moves the current clean non-main branch from the main
worktree into a linked worktree and returns the main checkout to the
default branch.
`worktree plan-id` prints the plan field for this guarded worktree.
`--bind` assigns an ID to a worktree created before this command existed.

`start` and `pr` are read-only gates — they print the next safe action
when a gate fails. `done` is a post-merge cleanup that fast-forwards
the default branch, then removes the worktree (if any) and the local
branch, after verifying the branch's PR is MERGED via `gh pr view`.
`plan-done` is a plan-only cleanup: it removes the worktree (if any)
and the local branch after verifying the branch is still at its
recorded base with no commits or working-tree changes beyond it, for a
plan-only ticket that intentionally never opens a PR. It never touches
`gh`, never fetches, and never moves the default branch.

Flags for `check start`:
  --read-only  demotes worktree-isolation and freshness to advisory
  --no-fetch   skips `git fetch --all --prune`; freshness uses cached refs.
               Only safe when the caller already fetched.

Flags for `check plan-done`:
  --resume-branch <branch>  reconciles an interrupted plan-only teardown
                            from the main worktree.
  --ticket-source <source>  binds resumed teardown to github or local evidence.
  --ticket-id <id>          binds resumed teardown to the ticket evidence id.
EOF
}

fail() {
  printf 'safe-git: BLOCKED: %s\n' "$*" >&2
  exit 1
}

ok() {
  printf 'safe-git: OK: %s\n' "$*"
}

warn() {
  printf 'safe-git: WARNING: %s\n' "$*" >&2
}

branch_ref_exists() {
  local branch="$1" rc
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    return 0
  else
    rc=$?
  fi
  [[ "$rc" -eq 1 ]] \
    || fail "could not determine whether branch $branch exists; refusing teardown"
  return 1
}

require_repo() {
  git rev-parse --show-toplevel >/dev/null 2>&1 || fail "not inside a git repository"
}

branch_name() {
  git branch --show-current
}

is_main_branch() {
  local branch="$1"
  [[ "$branch" == "main" || "$branch" == "master" ]]
}

is_canonical_branch_name() {
  local normalized
  case "$1" in refs/* | heads/* | '@{-'*) return 1 ;; esac
  normalized="$(git check-ref-format --branch "$1" 2>/dev/null)" || return 1
  [[ "$normalized" == "$1" ]] || return 1
}

is_main_worktree() {
  # Submodules have both git-dir and git-common-dir pointing into
  # .git/modules/<name>, which would look like the main worktree by
  # the dir-equality heuristic. Treat them as non-main worktrees so
  # we don't refuse implementation work inside a submodule checkout.
  if [[ -n "$(git rev-parse --show-superproject-working-tree 2>/dev/null)" ]]; then
    return 1
  fi
  local git_dir common_dir
  # Resolve both to absolute paths so relative-vs-absolute differences
  # (which git rev-parse reports inconsistently across contexts) don't
  # cause a false negative.
  git_dir="$(cd "$(git rev-parse --git-dir)" && pwd)"
  common_dir="$(cd "$(git rev-parse --git-common-dir)" && pwd)"
  [[ "$git_dir" == "$common_dir" ]]
}

is_linked_worktree() {
  if [[ -n "$(git rev-parse --show-superproject-working-tree 2>/dev/null)" ]]; then
    return 1
  fi
  ! is_main_worktree
}

check_clean_state() {
  # Block when HEAD is partial: commits made here are either lost or
  # land unpredictably when the operation finishes.
  local git_dir
  git_dir="$(git rev-parse --git-dir)" \
    || fail "could not resolve Git operation state; refusing teardown."
  [[ ! -d "$git_dir/rebase-merge" ]] || fail "rebase in progress. Finish or abort before continuing."
  [[ ! -d "$git_dir/rebase-apply" ]] || fail "rebase in progress. Finish or abort before continuing."
  [[ ! -f "$git_dir/MERGE_HEAD" ]] || fail "merge in progress. Finish or abort before continuing."
  [[ ! -f "$git_dir/CHERRY_PICK_HEAD" ]] || fail "cherry-pick in progress. Finish or abort before continuing."
  [[ ! -f "$git_dir/REVERT_HEAD" ]] || fail "revert in progress. Finish or abort before continuing."
  [[ ! -f "$git_dir/BISECT_LOG" ]] || fail "bisect in progress. Finish or abort before continuing."
}

check_worktree_clean() {
  local label="${1:-working tree}" status
  # Dirty tree means teardown would discard work. `--porcelain` covers
  # unstaged, staged, and untracked; `--untracked-files=normal` keeps a
  # configured status.showUntrackedFiles=no from hiding untracked files.
  status="$(git status --porcelain --untracked-files=normal)" \
    || fail "could not inspect $label status; refusing teardown."
  if [[ -n "$status" ]]; then
    fail "$label is dirty. Commit, push, or stash before teardown."
  fi
}

plan_only_checkpoint_fields() {
  local evidence="$1"
  awk '
    function finish_checkpoint() {
      if (!in_checkpoint || phase != "2") return
      if (valid && phase_count == 1 && status_count == 1 && review_count == 1 && exit_count == 1) {
        last = status "|" plan_review
      } else {
        last = "invalid|invalid"
      }
    }
    /^ticket-checkpoint v1$/ {
      finish_checkpoint()
      in_checkpoint=1; valid=1; closed=0
      phase=""; status=""; plan_review=""
      phase_count=0; status_count=0; review_count=0; exit_count=0
      next
    }
    /^[[:space:]]*$/ { finish_checkpoint(); in_checkpoint=0; next }
    !in_checkpoint { next }
    $1=="exit:" {
      exit_count++
      if (phase != "2" || status_count != 1 || review_count != 1 \
          || exit_count != 1 \
          || $0 != "exit: evidence artifact has goal, verifiable steps, execution contract, and clean plan review") valid=0
      closed=1
      next
    }
    closed { next }
    $1=="phase:" {
      phase_count++
      if (phase_count != 1 || status_count || review_count || $0 != "phase: 2 plan") valid=0
      phase=$2
      next
    }
    $1=="status:" {
      status_count++
      if (phase_count != 1 || status_count != 1 || review_count || NF != 2) valid=0
      status=$2
      next
    }
    $1=="plan_review:" {
      review_count++
      if (phase != "2" || status_count != 1 || review_count != 1 || NF != 2) valid=0
      plan_review=$2
      next
    }
    END { finish_checkpoint(); print last }
  ' "$evidence"
}

default_base_ref() {
  local default_branch
  default_branch="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)"
  printf 'origin/%s\n' "${default_branch:-main}"
}

default_branch_name() {
  local default_branch
  default_branch="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)"
  printf '%s\n' "${default_branch:-main}"
}

# Derive the local branch name from a remote-tracking ref.
# Handles both `origin/main` and `refs/remotes/origin/main` forms,
# as well as bare branch names like `main` (passed through as-is).
ref_to_local_branch() {
  local ref="$1"
  local branch="${ref#refs/remotes/}"
  branch="${branch#origin/}"
  printf '%s\n' "$branch"
}

fast_forward_default_branch() {
  local default_branch default_ref
  default_branch="$(default_branch_name)"
  default_ref="origin/$default_branch"
  git checkout "$default_branch" \
    || fail "could not switch to $default_branch; resolve manually"
  git fetch origin "$default_branch" \
    || fail "could not fetch $default_ref; resolve manually"
  git merge --ff-only "$default_ref" \
    || fail "could not fast-forward $default_branch; resolve manually"
}

# Best-effort default-branch update for a dirty main checkout. Never
# switches branches (that would carry the edits onto another branch);
# `merge --ff-only` itself refuses when an incoming commit would
# overwrite a local edit, and `--no-autostash` keeps a configured
# merge.autoStash from rewriting the edits with conflict markers.
# Warns instead of failing. Each printed recovery command must do what
# this function would: target the default branch, fetch first, and pass
# --no-autostash; a merge run from another branch would advance it.
fast_forward_dirty_main_worktree() {
  local default_branch current_branch
  default_branch="$(default_branch_name)"
  current_branch="$(branch_name)"
  if [[ "$current_branch" != "$default_branch" ]]; then
    warn "main worktree is dirty and on ${current_branch:-detached HEAD}; did not switch it to $default_branch. Commit or stash the local edits, then run: git checkout $default_branch && git fetch origin $default_branch && git merge --ff-only --no-autostash origin/$default_branch"
    return 0
  fi
  if ! git fetch origin "$default_branch"; then
    warn "main worktree is dirty and fetching origin/$default_branch failed; did not fast-forward $default_branch. Run: git fetch origin $default_branch && git merge --ff-only --no-autostash origin/$default_branch"
    return 0
  fi
  if ! git merge --ff-only --no-autostash "origin/$default_branch"; then
    warn "main worktree is dirty and did not fast-forward $default_branch to origin/$default_branch; local edits left untouched. Commit or stash them, then run: git merge --ff-only --no-autostash origin/$default_branch"
  fi
  return 0
}

main_worktree_path() {
  local main_wt
  main_wt="$("$SAFE_GIT_BIN_DIR/resolve-main-worktree")" \
    || fail "could not resolve main worktree; refusing worktree operation"
  printf '%s\n' "$main_wt"
}

check_branch_not_main() {
  local branch
  branch="$(branch_name)"
  [[ -n "$branch" ]] || fail "detached HEAD; use safe-git worktree start from the default branch for new work, or switch to the feature branch you already created"
  if is_main_branch "$branch"; then
    fail "current branch is $branch. Use safe-git worktree start .worktrees/<task> -b <feature-branch> --purpose \"<why this worktree exists>\" before writing. If work already happened here, move it into a linked worktree instead of just creating a branch and continuing in the main worktree."
  fi
}

fetch_remotes() {
  git fetch --all --prune
}

check_freshness() {
  local branch upstream behind ahead
  branch="$(branch_name)"

  if upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"; then
    # Capture into variables so a failing `git log` surfaces as an
    # error instead of an empty string that reads as "up to date".
    # `set -e` is disabled inside `if (( ))` and `[[ ... ]]` test
    # conditions, so the previous command-substitution pattern
    # silently swallowed errors.
    behind="$(git log "HEAD..$upstream" --oneline)" \
      || fail "git log HEAD..$upstream failed; cannot verify freshness"
    ahead="$(git log "$upstream..HEAD" --oneline)" \
      || fail "git log $upstream..HEAD failed; cannot verify freshness"
    if [[ -n "$behind" ]]; then
      if [[ -n "$ahead" ]]; then
        fail "branch has diverged from $upstream. Resolve manually before continuing."
      fi
      fail "branch is behind $upstream. Pull or rebase before continuing."
    fi
    ok "branch is up to date with $upstream"
    return
  fi

  # No upstream configured: enumerate every remote, not just origin.
  # Rev-parsing only origin/$branch missed fork workflows that name
  # the primary remote `upstream`, `fork`, etc., returning a false OK
  # when a same-named remote branch existed. Branch names cannot
  # contain `*`, `?`, `[`, or whitespace (git-check-ref-format), so
  # $branch is safe as a for-each-ref pattern and as an output token.
  local matching
  matching="$(git for-each-ref --format='%(refname:short)' "refs/remotes/*/$branch" 2>/dev/null | tr '\n' ' ')"
  matching="${matching% }"

  if [[ -n "$matching" ]]; then
    fail "no upstream is configured, but same-named branch exists on: $matching. Set upstream or compare/rebase explicitly before continuing."
  fi

  ok "branch has no upstream and no same-named branch on any remote"
}

check_start() {
  local read_only=false no_fetch=false base_ref
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --read-only) read_only=true; shift ;;
      --no-fetch) no_fetch=true; shift ;;
      *) fail "unknown option for check start: $1 (usage: safe-git check start [--read-only] [--no-fetch])" ;;
    esac
  done

  require_repo
  # Clean-state is checked even for --read-only: HEAD is partial
  # during rebase/merge/cherry-pick, so any read against it is
  # misleading. Only worktree and freshness are demoted to advisory
  # by --read-only.
  check_clean_state
  if "$read_only"; then
    ok "read-only check; worktree isolation and freshness are advisory"
    return
  fi

  if ! "$no_fetch"; then
    fetch_remotes
  fi
  if is_main_worktree; then
    base_ref="$(default_base_ref)"
    git rev-parse --verify --quiet "$base_ref" >/dev/null || fail "main worktree detected, but default base $base_ref does not exist. Choose an explicit base ref for the new worktree."
    fail "main worktree detected. Create an isolated worktree, for example: safe-git worktree start .worktrees/<task> -b <feature-branch> --base $base_ref --purpose \"<why this worktree exists>\""
  fi

  check_branch_not_main
  check_freshness
}

check_pr() {
  if [[ $# -gt 0 ]]; then
    fail "unknown option for check pr: $1 (usage: safe-git check pr)"
  fi
  require_repo
  check_clean_state
  check_branch_not_main
  ok "current branch is eligible for PR creation"
}

check_done() {
  if [[ $# -gt 0 ]]; then
    fail "unknown option for check done: $1 (usage: safe-git check done)"
  fi
  require_repo
  # Clean-state first: if rebase/merge/cherry-pick is in flight, HEAD
  # is partial and we cannot reason about what "merged" means.
  check_clean_state

  local branch
  branch="$(branch_name)"
  [[ -n "$branch" ]] || fail "detached HEAD; nothing to clean up"
  if is_main_branch "$branch"; then
    fail "current branch is $branch; refusing to delete the default branch"
  fi

  check_worktree_clean

  # Verify the PR is MERGED and that local HEAD matches the commit
  # GitHub merged. Anything else (no PR, wrong state, diverged local
  # commits, gh failure) refuses — we will not tear down without an
  # authoritative signal. `--template` avoids a jq dependency; the
  # template emits a state and head separated by one literal space.
  command -v gh >/dev/null 2>&1 \
    || fail "gh CLI not available; cannot verify PR merged state"

  local gh_out state pr_head
  if ! gh_out="$(gh pr view --json state,headRefOid --template '{{.state}} {{.headRefOid}}' 2>/dev/null)"; then
    fail "gh pr view failed; verify a PR exists for $branch and gh is authenticated"
  fi
  state="${gh_out%% *}"
  pr_head=""
  if [[ "$gh_out" == *" "* ]]; then
    pr_head="${gh_out#* }"
  fi
  if [[ "$state" != "MERGED" ]]; then
    fail "PR for $branch is in state '$state', not MERGED; refusing teardown"
  fi
  [[ -n "$pr_head" ]] \
    || fail "gh pr view returned empty headRefOid; cannot verify local tip matches merged commit"

  # HEAD must match the commit GitHub merged. Otherwise local has
  # commits that were not part of the merged PR (e.g., committed
  # after merge, or force-pushed out of sync), and `branch -D` would
  # destroy them silently.
  local local_head
  local_head="$(git rev-parse HEAD)"
  if [[ "$local_head" != "$pr_head" ]]; then
    local short_local short_pr
    short_local="$(git rev-parse --short HEAD)"
    short_pr="$(git rev-parse --short "$pr_head" 2>/dev/null || echo "${pr_head:0:7}")"
    fail "local HEAD ($short_local) differs from PR's merged tip ($short_pr); branch has commits not reflected in the merged PR. Push, rebase, or investigate before teardown."
  fi

  # Gates cleared. Execute teardown.
  local this_dir_ref common_dir_ref this_dir common_dir
  this_dir_ref="$(git rev-parse --git-dir)" \
    || fail "could not resolve worktree Git directory; refusing teardown"
  common_dir_ref="$(git rev-parse --git-common-dir)" \
    || fail "could not resolve Git common directory; refusing teardown"
  this_dir="$(cd "$this_dir_ref" && pwd -P)" \
    || fail "could not enter worktree Git directory; refusing teardown"
  common_dir="$(cd "$common_dir_ref" && pwd -P)" \
    || fail "could not enter Git common directory; refusing teardown"

  if [[ "$this_dir" == "$common_dir" ]]; then
    # Main worktree: switch to the default branch, then delete.
    fast_forward_default_branch
    git branch -D "$branch" \
      || fail "git branch -D $branch failed"
    remove_worktree_metadata "$branch" \
      || fail "could not remove worktree metadata for $branch"
    ok "PR merged; branch $branch deleted"
    return
  fi

  # Linked worktree: cd out to the main worktree before removing, so
  # git has a valid cwd after removal. Resolve a real checkout, not
  # the metadata directory some Git layouts list first.
  local wt_path main_wt
  wt_path="$(git rev-parse --show-toplevel)"
  main_wt="$(main_worktree_path)" || return 1
  # Explicit cd guard: bash's `set -e` handling inside a subshell
  # that's part of a `( ... ) || ...` construct is inconsistent
  # across versions, so a cd failure could otherwise cascade into
  # 'git worktree remove' (which runs without needing cwd) and only
  # surface as a confusing 'branch -D failed'. Fail loud at cd.
  #
  # A dirty main checkout holds unrelated local edits, not feature work,
  # so it does not block teardown: the feature side is already proven
  # clean and merged. Only the default-branch update touches main, and
  # it becomes best-effort after teardown instead of a precondition.
  (
    cd "$main_wt" \
      || { printf 'safe-git: BLOCKED: cannot cd to main worktree %s\n' "$main_wt" >&2; exit 1; }
    local main_status main_dirty=0
    main_status="$(git status --porcelain --untracked-files=normal)" \
      || { printf 'safe-git: BLOCKED: could not inspect main worktree status; refusing teardown.\n' >&2; exit 1; }
    [[ -z "$main_status" ]] || main_dirty=1
    if (( ! main_dirty )); then
      fast_forward_default_branch
    fi
    git worktree remove "$wt_path" \
      || { printf 'safe-git: BLOCKED: git worktree remove %s failed\n' "$wt_path" >&2; exit 1; }
    git branch -D "$branch" \
      || { printf 'safe-git: BLOCKED: git branch -D %s failed\n' "$branch" >&2; exit 1; }
    remove_worktree_metadata "$branch" \
      || fail "could not remove worktree metadata for $branch"
    if (( main_dirty )); then
      fast_forward_dirty_main_worktree
    fi
  ) || exit 1
  ok "PR merged; worktree $wt_path and branch $branch removed"
}

check_plan_done() {
  local resume_branch="" resume_ticket_source="" resume_ticket_id=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --resume-branch)
        require_value "$1" "${2:-}"
        resume_branch="$2"
        shift 2
        ;;
      --ticket-source)
        require_value "$1" "${2:-}"
        resume_ticket_source="$2"
        shift 2
        ;;
      --ticket-id)
        require_value "$1" "${2:-}"
        resume_ticket_id="$2"
        shift 2
        ;;
      *) fail "unknown option for check plan-done: $1 (usage: safe-git check plan-done [--resume-branch BRANCH --ticket-source SOURCE --ticket-id ID])" ;;
    esac
  done
  require_repo
  if [[ -n "$resume_branch" ]]; then
    if [[ -n "$resume_ticket_source" || -n "$resume_ticket_id" ]]; then
      [[ "$resume_ticket_source" == github || "$resume_ticket_source" == local ]] \
        || fail "--resume-branch requires --ticket-source github|local"
      [[ "$resume_ticket_id" =~ ^[A-Za-z0-9._][A-Za-z0-9._-]*$ ]] \
        || fail "--resume-branch requires a valid --ticket-id"
    fi
    resume_plan_done "$resume_branch" "$resume_ticket_source" "$resume_ticket_id"
    return
  fi
  [[ -z "$resume_ticket_source" && -z "$resume_ticket_id" ]] \
    || fail "--ticket-source and --ticket-id require --resume-branch"
  # Clean-state first: if rebase/merge/cherry-pick is in flight, HEAD
  # is partial and we cannot reason about the branch being at its base.
  check_clean_state

  local branch
  branch="$(branch_name)"
  [[ -n "$branch" ]] || fail "detached HEAD; nothing to clean up"
  if is_main_branch "$branch"; then
    fail "current branch is $branch; refusing to delete the default branch"
  fi

  check_worktree_clean

  # Verify the branch sits exactly at its recorded base. Plan-only
  # tickets never open a PR, so there is no gh signal to trust — the
  # metadata Base is the authoritative baseline. Any of missing
  # metadata, an unresolvable base, or commits beyond base refuses:
  # we will not tear down a branch we cannot prove is clean.
  local base
  base="$(metadata_base_ref "$branch")" || return 1
  # Peel to a commit: rev-list --count requires a commit range, and a
  # tree/blob base (hand-edited metadata) would make `git rev-list`
  # fail mid-substitution, exiting the script silently under `set -e`
  # instead of refusing loudly.
  local base_sha
  base_sha="$(git rev-parse --verify --quiet "$base^{commit}")" \
    || fail "recorded base $base for $branch is not a commit; refusing teardown"

  # Require exact equality with the recorded base. A two-dot count
  # (`git rev-list --count "$base..HEAD" == 0`) only proves HEAD has no
  # commits beyond base — HEAD being an ancestor of base — so a branch
  # reset behind its base (e.g. `git reset --hard <base>^`) would count
  # 0 and be torn down. Comparing the peeled SHAs directly fails closed
  # on any drift in either direction.
  local head_sha
  head_sha="$(git rev-parse --verify 'HEAD^{commit}')" \
    || fail "could not resolve HEAD for $branch; refusing teardown"
  [[ "$head_sha" == "$base_sha" ]] \
    || fail "branch $branch HEAD ($head_sha) differs from recorded base $base; plan-only teardown requires the branch to sit exactly at its base"

  # Require plan evidence to be archived before teardown. `.plans/` is
  # gitignored, so `check_worktree_clean` never sees a ticket evidence
  # file and `git worktree remove` would delete it along with the
  # worktree. When plan-done is invoked directly (or the ticket flow's
  # archive step was skipped), refuse rather than silently destroy the
  # only durable plan record. The archive is source-qualified
  # (ticket-<source>-<id>-evidence.md) in the main checkout's .plans/.
  local this_dir_ref common_dir_ref this_dir common_dir
  this_dir_ref="$(git rev-parse --git-dir)" \
    || fail "could not resolve worktree Git directory; refusing teardown"
  common_dir_ref="$(git rev-parse --git-common-dir)" \
    || fail "could not resolve Git common directory; refusing teardown"
  this_dir="$(cd "$this_dir_ref" && pwd -P)" \
    || fail "could not enter worktree Git directory; refusing teardown"
  common_dir="$(cd "$common_dir_ref" && pwd -P)" \
    || fail "could not enter Git common directory; refusing teardown"

  local wt_root evidence_archived main_wt
  wt_root="$(git rev-parse --show-toplevel)" \
    || fail "could not resolve worktree root; refusing teardown"
  main_wt="$(main_worktree_path)" || return 1
  evidence_archived=true
  local ticket_source ticket_id
  ticket_source="$(metadata_ticket_source "$branch")" || return 1
  ticket_id="$(metadata_ticket_id "$branch")" || return 1
  # Normalize the recorded issue id: the documented `--issue "#204"` form
  # retains the leading `#`, which would build ticket-#204-evidence.md
  # instead of ticket-204-evidence.md.
  ticket_id="${ticket_id#\#}"

  # Require the ticket binding metadata. plan-done is a plan-only teardown:
  # without both the recorded issue id and ticket source it cannot locate the
  # deliverable or its archive, so a worktree whose metadata lacks either
  # must refuse rather than tear down ignored .plans/ evidence unverified.
  if [[ ! "$ticket_id" =~ ^[A-Za-z0-9._][A-Za-z0-9._-]*$ ]] \
      || [[ "$ticket_source" != github && "$ticket_source" != local ]]; then
    printf 'safe-git: BLOCKED: worktree metadata for %s has an invalid ticket id or source; refusing plan-only teardown\n' "$branch" >&2
    evidence_archived=false
  fi

  # Validate ONLY the metadata-bound evidence file for THIS ticket. A scan
  # over every .plans/ticket-*-evidence.md is wrong: when the plan-only
  # branch is checked out in the main worktree, wt_root equals main_wt, so
  # the .plans/ dir may also hold archives for OTHER tickets (and, after
  # this ticket's own archive, this ticket's archive), and a broad scan
  # would treat those as source evidence and refuse a valid cleanup.
  local expected_evidence=""
  if "$evidence_archived"; then
    expected_evidence="$wt_root/.plans/ticket-$ticket_id-evidence.md"
    if [[ ! -f "$expected_evidence" || -L "$expected_evidence" ]]; then
      printf 'safe-git: BLOCKED: expected plan evidence %s is not a regular non-symlink file; plan-only teardown requires the plan deliverable\n' "$expected_evidence" >&2
      evidence_archived=false
    fi
  fi
  # Require the evidence's Phase 2 checkpoint to be a genuine plan_only stop.
  # A mistakenly invoked check plan-done must not tear down a ticket whose
  # checkpoint is done/blocked/awaiting_human_input or absent. Parse complete
  # `ticket-checkpoint v1` records — never arbitrary `phase:`/`status:` lines
  # in plan prose — and use the LAST phase-2 block's status (the evidence is
  # append-only, so the plan_only stop's render-checkpoint appends after the
  # earlier phase-2 done exit).
  if "$evidence_archived"; then
    local phase2_status phase2_plan_review
    phase2_status="$(plan_only_checkpoint_fields "$expected_evidence")" \
      || fail "could not parse plan evidence $expected_evidence"
    phase2_plan_review="${phase2_status#*|}"
    phase2_status="${phase2_status%%|*}"
    # Require a genuine plan_only stop AND a real plan deliverable: the Phase-2
    # block must record status=plan_only and plan_review=clean. A minimal
    # plan_only stub with no plan (authoring skipped or evidence overwritten)
    # must refuse teardown.
    if [[ "$phase2_status" != "plan_only" ]]; then
      printf 'safe-git: BLOCKED: evidence %s Phase 2 status is %s, not plan_only; refusing plan-only teardown\n' "$expected_evidence" "${phase2_status:-absent}" >&2
      evidence_archived=false
    elif [[ "$phase2_plan_review" != "clean" ]]; then
      printf 'safe-git: BLOCKED: evidence %s Phase 2 plan_review is %s, not clean; refusing plan-only teardown without a reviewed plan deliverable\n' "$expected_evidence" "${phase2_plan_review:-absent}" >&2
      evidence_archived=false
    fi
  fi
  # Require the EXACT byte-identical archive bound to this ticket's source.
  # The ticket flow archives the whole .plans/ tree into the source-qualified
  # bundle <main-checkout>/.plans/ticket-<source>-<id>/, so the evidence is at
  # <bundle>/.plans/ticket-<id>-evidence.md (the bundle mirrors the worktree's
  # .plans/ tree, keeping every referenced artifact's path resolvable). A
  # wildcard over the source segment would accept the opposite source's
  # archive when a local and GitHub ticket share an id with byte-identical
  # evidence.
  if "$evidence_archived"; then
    local archive="$main_wt/.plans/ticket-$ticket_source-$ticket_id/.plans/ticket-$ticket_id-evidence.md"
    if [[ ! -d "$main_wt/.plans" || -L "$main_wt/.plans" \
          || ! -f "$archive" || -L "$archive" ]] \
        || ! cmp -s "$archive" "$expected_evidence"; then
      printf 'safe-git: BLOCKED: plan evidence %s has no byte-identical archive %s; archive the current evidence before plan-only teardown\n' "$expected_evidence" "$archive" >&2
      evidence_archived=false
    fi
  fi
  if "$evidence_archived"; then
    run_plan_archive_comparison \
      "$wt_root/.plans" \
      "$main_wt/.plans/ticket-$ticket_source-$ticket_id/.plans" \
      || fail "worktree .plans differs from archive; re-archive before teardown"
  fi
  "$evidence_archived" || exit 1

  # Gates cleared. Execute teardown — same shape as check_done's
  # main/linked paths, but WITHOUT gh, fetch, default-branch
  # fast-forward, or a main-worktree clean gate: nothing was merged, so
  # the default branch must not move.

  if [[ "$this_dir" == "$common_dir" ]]; then
    # Main worktree: switch to the default branch first (a branch cannot
    # be deleted while checked out), then delete. Mirrors
    # fast_forward_default_branch's checkout without the fetch/merge.
    git checkout "$(default_branch_name)" \
      || fail "could not switch to $(default_branch_name); resolve manually"
    git branch -D "$branch" \
      || fail "git branch -D $branch failed"
    remove_worktree_metadata "$branch" \
      || fail "could not remove worktree metadata for $branch"
    ok "plan-only branch $branch deleted"
    return
  fi

  # Linked worktree: cd out to the main worktree before removing, so
  # git has a valid cwd after removal. Resolve a real checkout, not
  # the metadata directory some Git layouts list first.
  local main_wt
  main_wt="$(main_worktree_path)" || return 1
  # Explicit cd guard: bash's `set -e` handling inside a subshell
  # that's part of a `( ... ) || ...` construct is inconsistent
  # across versions, so a cd failure could otherwise cascade into
  # 'git worktree remove' (which runs without needing cwd) and only
  # surface as a confusing 'branch -D failed'. Fail loud at cd.
  (
    cd "$main_wt" \
      || { printf 'safe-git: BLOCKED: cannot cd to main worktree %s\n' "$main_wt" >&2; exit 1; }
    git worktree remove "$wt_root" \
      || { printf 'safe-git: BLOCKED: git worktree remove %s failed\n' "$wt_root" >&2; exit 1; }
    git branch -D "$branch" \
      || { printf 'safe-git: BLOCKED: git branch -D %s failed\n' "$branch" >&2; exit 1; }
    remove_worktree_metadata "$branch" \
      || fail "could not remove worktree metadata for $branch"
  ) || exit 1
  ok "plan-only worktree $wt_root and branch $branch removed"
}

# Resume a plan-only teardown whose caller persisted the branch before invoking
# the destructive path. The worktree may still be intact, may already be gone
# while branch deletion failed, or both branch and metadata may already be gone
# while the caller's completion-token write was interrupted.
validate_resumed_plan_archive() {
  local ticket_source="$1" ticket_id="$2" main_wt archive phase2
  main_wt="$(main_worktree_path)" || return 1
  [[ -d "$main_wt/.plans" && ! -L "$main_wt/.plans" ]] \
    || fail "main plan archive root $main_wt/.plans is not a real directory; refusing resumed teardown"
  archive="$main_wt/.plans/ticket-$ticket_source-$ticket_id/.plans/ticket-$ticket_id-evidence.md"
  [[ -f "$archive" && ! -L "$archive" ]] \
    || fail "archived plan evidence $archive is missing; refusing resumed teardown"
  plan_tree_has_only_regular_entries \
    "$main_wt/.plans/ticket-$ticket_source-$ticket_id/.plans" \
    || fail "archived plan tree contains a non-regular entry; refusing resumed teardown"
  phase2="$(plan_only_checkpoint_fields "$archive")" \
    || fail "could not parse archived plan evidence for $ticket_source ticket $ticket_id"
  [[ "$phase2" == "plan_only|clean" ]] \
    || fail "archived evidence is not a reviewed plan-only stop for $ticket_source ticket $ticket_id"
}

resume_plan_done() {
  local branch="$1" expected_ticket_source="$2" expected_ticket_id="$3"
  is_canonical_branch_name "$branch" \
    || fail "invalid --resume-branch value"
  is_main_branch "$branch" \
    && fail "resume branch is $branch; refusing to delete the default branch"

  local metadata_path
  metadata_path="$(worktree_metadata_path "$branch")" || return 1
  if [[ ! -e "$metadata_path" && ! -L "$metadata_path" ]]; then
    if branch_ref_exists "$branch"; then
      fail "no worktree metadata for $branch; refusing resumed teardown"
    fi
    [[ -n "$expected_ticket_source" && -n "$expected_ticket_id" ]] \
      || fail "completed resume requires --ticket-source and --ticket-id to revalidate its archive"
    validate_resumed_plan_archive "$expected_ticket_source" "$expected_ticket_id"
    ok "plan-only teardown for $branch was already complete"
    return
  fi
  validate_worktree_metadata_authority "$branch" >/dev/null

  local recorded_branch recorded_path base ticket_source ticket_id main_wt archive
  recorded_branch="$(sed -n 's/^- Branch: //p' "$metadata_path")" \
    || fail "could not read worktree metadata for $branch"
  recorded_path="$(sed -n 's/^- Path: //p' "$metadata_path")" \
    || fail "could not read worktree metadata for $branch"
  base="$(metadata_base_ref "$branch")" || return 1
  ticket_source="$(metadata_ticket_source "$branch")" || return 1
  ticket_id="$(metadata_ticket_id "$branch")" || return 1
  ticket_id="${ticket_id#\#}"
  [[ "$recorded_branch" == "$branch" && -n "$recorded_path" ]] \
    || fail "worktree metadata does not bind resume branch $branch to a path"
  [[ "$ticket_source" == github || "$ticket_source" == local ]] \
    || fail "worktree metadata for $branch has no valid ticket source"
  [[ "$ticket_id" =~ ^[A-Za-z0-9._][A-Za-z0-9._-]*$ ]] \
    || fail "worktree metadata for $branch has no valid ticket id"
  if [[ -n "$expected_ticket_source" || -n "$expected_ticket_id" ]]; then
    [[ "$ticket_source:$ticket_id" == "$expected_ticket_source:$expected_ticket_id" ]] \
      || fail "resume ticket identity does not match worktree metadata for $branch"
  fi
  local base_sha branch_sha
  base_sha="$(git rev-parse --verify --quiet "$base^{commit}")" \
    || fail "recorded base $base for $branch is not a commit; refusing resumed teardown"
  if branch_ref_exists "$branch"; then
    branch_sha="$(git rev-parse --verify "refs/heads/$branch^{commit}")" \
      || fail "could not resolve branch $branch; refusing resumed teardown"
    [[ "$branch_sha" == "$base_sha" ]] \
      || fail "branch $branch differs from recorded base $base; refusing resumed teardown"
  fi

  main_wt="$(main_worktree_path)" || return 1
  archive="$main_wt/.plans/ticket-$ticket_source-$ticket_id/.plans/ticket-$ticket_id-evidence.md"
  validate_resumed_plan_archive "$ticket_source" "$ticket_id"

  local registered_path
  registered_path="$(git worktree list --porcelain | awk -v wanted="refs/heads/$branch" '
    $1=="worktree" {sub(/^worktree /, ""); path=$0}
    $1=="branch" && $2==wanted {print path; exit}
  ')"
  if [[ -n "$registered_path" ]]; then
    (
      cd "$registered_path" \
        || { printf 'safe-git: BLOCKED: cannot cd to surviving worktree %s\n' "$registered_path" >&2; exit 1; }
      check_clean_state
      check_worktree_clean "worktree $registered_path"
    ) || return 1
    run_plan_archive_comparison \
      "$registered_path/.plans" \
      "$main_wt/.plans/ticket-$ticket_source-$ticket_id/.plans" \
      || fail "surviving worktree .plans differs from archive; re-archive before resumed teardown"
    if [[ "$registered_path" == "$main_wt" ]]; then
      git -C "$main_wt" checkout "$(default_branch_name)" \
        || fail "could not switch to $(default_branch_name); resolve manually"
    else
      git worktree remove "$registered_path" \
        || fail "git worktree remove $registered_path failed during resumed teardown"
    fi
  elif [[ "$recorded_path" != "$main_wt" && -e "$recorded_path" ]]; then
    fail "recorded worktree path $recorded_path still exists but is not registered; refusing resumed teardown"
  fi

  if branch_ref_exists "$branch"; then
    git branch -D "$branch" \
      || fail "git branch -D $branch failed during resumed teardown"
  fi
  remove_worktree_metadata "$branch" \
    || fail "could not remove worktree metadata for $branch"
  ok "plan-only teardown for $branch reconciled"
}

# Keep the top-level safe-git process responsible for comparison-worker
# cancellation. A signal sent only to safe-git must not orphan the worker.
cleanup_plan_archive_comparison() {
  local compare_dir="$1"
  [[ -n "$compare_dir" ]] || return
  # unsafe-path-exempt: exact mktemp directory minted by run_plan_archive_comparison
  rm -rf -- "$compare_dir"
}

stop_plan_archive_group() {
  local signal="$1" exit_code="$2" compare_pid="$3" compare_dir="$4"
  trap - HUP INT TERM
  kill -"$signal" -- "-$compare_pid" 2>/dev/null \
    || kill -"$signal" "$compare_pid" 2>/dev/null \
    || true
  sleep 0.1
  kill -KILL -- "-$compare_pid" 2>/dev/null \
    || kill -KILL "$compare_pid" 2>/dev/null \
    || true
  wait "$compare_pid" 2>/dev/null || true
  cleanup_plan_archive_comparison "$compare_dir"
  exit "$exit_code"
}

run_plan_archive_comparison() {
  local source_plans="$1" archived_plans="$2" compare_pid="" compare_rc
  local compare_dir="" pending_signal="" signal exit_code
  handle_plan_archive_signal() {
    signal="$1"
    exit_code="$2"
    if [[ -z "$compare_pid" ]]; then
      pending_signal="$signal:$exit_code"
      return
    fi
    stop_plan_archive_group "$signal" "$exit_code" "$compare_pid" "$compare_dir"
  }
  # Install handlers before spawning the worker. If a signal arrives during
  # the short spawn/assignment window, record it and stop the new group as soon
  # as its PID is known instead of orphaning it.
  trap 'handle_plan_archive_signal HUP 129' HUP
  trap 'handle_plan_archive_signal INT 130' INT
  trap 'handle_plan_archive_signal TERM 143' TERM
  compare_dir="$(mktemp -d "${TMPDIR:-/tmp}/safe-git-plan-compare.XXXXXXXX")" || {
    trap - HUP INT TERM
    unset -f handle_plan_archive_signal
    return 1
  }
  if [[ -n "$pending_signal" ]]; then
    cleanup_plan_archive_comparison "$compare_dir"
    exit_code="${pending_signal#*:}"
    exit "$exit_code"
  fi
  # A background job gets its own process group under monitor mode. The worker
  # keeps monitor mode off, so tar/diff descendants inherit that same group.
  set -m
  plan_archive_matches_source "$source_plans" "$archived_plans" "$compare_dir" &
  compare_pid=$!
  if [[ -n "$pending_signal" ]]; then
    signal="${pending_signal%%:*}"
    exit_code="${pending_signal#*:}"
    stop_plan_archive_group "$signal" "$exit_code" "$compare_pid" "$compare_dir"
  fi
  if wait "$compare_pid"; then
    compare_rc=0
  else
    compare_rc=$?
  fi
  compare_pid=""
  set +m
  cleanup_plan_archive_comparison "$compare_dir"
  trap - HUP INT TERM
  if [[ -n "$pending_signal" ]]; then
    exit_code="${pending_signal#*:}"
    exit "$exit_code"
  fi
  unset -f handle_plan_archive_signal
  return "$compare_rc"
}

# Compare the complete plan tree that the ticket archive contract preserves.
# Prior source-qualified bundles are excluded only when their nested evidence
# marker proves they are bundles; similarly named log directories stay in scope.
plan_tree_has_only_regular_entries() {
  local root="$1" unsafe_entry parent
  parent="${root%/*}"
  [[ -d "$root" && ! -L "$root" && ! -L "$parent" ]] || return 1
  unsafe_entry="$(find "$root" -mindepth 1 ! \( -type f -o -type d \) -print)" \
    || return 1
  [[ -z "$unsafe_entry" ]]
}

plan_archive_matches_source() (
  local source_plans="$1" archived_plans="$2" compare_dir="$3" tar_path d has_evidence ev
  [[ -d "$source_plans" && -d "$archived_plans" ]] || return 1
  plan_tree_has_only_regular_entries "$source_plans" || return 1
  mkdir -p "$compare_dir/source" || return 1
  tar_path="$compare_dir/source.tar"
  local excludes=(--exclude='./.plan-only-cleanup-state-*' \
    --exclude='./.plan-only-cleanup-state-*/*')
  while IFS= read -r d; do
    [[ -n "$d" ]] || continue
    has_evidence=false
    for ev in "$source_plans/$d"/.plans/ticket-*-evidence.md; do
      [[ -f "$ev" && ! -L "$ev" ]] && has_evidence=true
    done
    "$has_evidence" || continue
    excludes+=(--exclude="$d" --exclude="$d/*")
  done < <(cd "$source_plans" && find . -maxdepth 1 -type d \( -name 'ticket-github-*' -o -name 'ticket-local-*' \))
  tar -C "$source_plans" -cf "$tar_path" "${excludes[@]}" . \
    && tar -C "$compare_dir/source" -xf "$tar_path" \
    && plan_tree_has_only_regular_entries "$compare_dir/source" \
    && plan_tree_has_only_regular_entries "$archived_plans" \
    && diff -qr "$compare_dir/source" "$archived_plans" >/dev/null
)

# Read the recorded base ref for a branch from its worktree metadata.
# Fails closed: missing metadata or an unparsable Base line refuses.
metadata_base_ref() {
  local branch="$1" metadata_path base
  metadata_path="$(validate_worktree_metadata_authority "$branch")" || return 1
  # `worktree adopt` records the literal `existing branch` as the base
  # (the branch predates adoption, so no base was recorded); treat it
  # like missing metadata — there is no ref to verify against.
  base="$(sed -n 's/^- Base: //p' "$metadata_path")" \
    || fail "could not read worktree metadata for $branch"
  [[ -n "$base" && "$base" != "existing branch" ]] \
    || fail "worktree metadata for $branch has no usable Base ref (adopted branches record none); cannot verify plan-only branch is at its base"
  printf '%s\n' "$base"
}

# Read the recorded ticket source (github|local) from a branch's worktree
# metadata. Empty when the worktree was created without --ticket-source.
metadata_ticket_source() {
  local branch="$1" metadata_path
  metadata_path="$(validate_worktree_metadata_authority "$branch")" || return 1
  sed -n 's/^- Ticket Source: //p' "$metadata_path" \
    || fail "could not read worktree metadata for $branch"
}

# Read the recorded issue id from a branch's worktree metadata. Empty when
# the worktree was created without --issue.
metadata_ticket_id() {
  local branch="$1" metadata_path
  metadata_path="$(validate_worktree_metadata_authority "$branch")" || return 1
  sed -n 's/^- Issue: //p' "$metadata_path" \
    || fail "could not read worktree metadata for $branch"
}

require_value() {
  local flag="$1" value="${2:-}"
  [[ -n "$value" ]] || fail "$flag requires a value"
}

worktree_metadata_root() {
  local common_ref common_dir
  common_ref="$(git rev-parse --git-common-dir)" \
    || fail "could not resolve Git common directory"
  common_dir="$(cd "$common_ref" && pwd -P)" \
    || fail "could not enter Git common directory"
  printf '%s/safe-git/worktrees\n' "$common_dir"
}

worktree_metadata_path() {
  local branch="$1" metadata_root
  metadata_root="$(worktree_metadata_root)" || return 1
  printf '%s/%s.md\n' "$metadata_root" "$branch"
}

validate_worktree_metadata_authority() {
  local branch="$1" metadata_path metadata_root metadata_parent unsafe_entry
  metadata_path="$(worktree_metadata_path "$branch")" || return 1
  metadata_root="$(worktree_metadata_root)" || return 1
  metadata_parent="${metadata_root%/worktrees}"
  [[ -d "$metadata_parent" && ! -L "$metadata_parent" ]] \
    || fail "worktree metadata authority parent is not a real directory"
  [[ -d "$metadata_root" && ! -L "$metadata_root" ]] \
    || fail "worktree metadata authority root is not a real directory"
  unsafe_entry="$(find "$metadata_root" -mindepth 1 \
    ! \( -type f -o -type d \) -print)" \
    || fail "could not validate worktree metadata authority"
  [[ -z "$unsafe_entry" ]] \
    || fail "worktree metadata authority contains a non-regular entry"
  [[ -f "$metadata_path" && ! -L "$metadata_path" ]] \
    || fail "no regular worktree metadata for $branch; cannot verify plan-only branch is at its base"
  printf '%s\n' "$metadata_path"
}

write_worktree_metadata() {
  local wt_path="$1" branch="$2" base_ref="$3" purpose="$4" issue="$5" title="$6" ticket_source="$7"
  local activity="${8:-Created worktree from $base_ref.}"
  local work_id="$9" metadata_path created abs_path
  [[ "$work_id" =~ ^[0-9a-f]{32}$ ]] || fail "invalid work ID for worktree metadata"
  metadata_path="$(worktree_metadata_path "$branch")" || return 1
  created="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  abs_path="$(cd "$wt_path" && pwd)"
  mkdir -p "$(dirname "$metadata_path")"
  {
    printf '# Worktree\n\n'
    printf -- '- Branch: %s\n' "$branch"
    printf -- '- Path: %s\n' "$abs_path"
    printf -- '- Base: %s\n' "$base_ref"
    printf -- '- Created: %s\n' "$created"
    printf -- '- Work ID: %s\n' "$work_id"
    if [[ -n "$issue" ]]; then
      printf -- '- Issue: %s\n' "$issue"
    fi
    if [[ -n "$ticket_source" ]]; then
      printf -- '- Ticket Source: %s\n' "$ticket_source"
    fi
    if [[ -n "$title" ]]; then
      printf -- '- Title: %s\n' "$title"
    fi
    printf '\n## Purpose\n\n'
    printf '%s\n' "$purpose"
    printf '\n## Activity Log\n\n'
    printf -- '- %s %s\n' "$created" "$activity"
  } >"$metadata_path"
}

new_work_id() {
  local work_id
  work_id="$(od -An -N16 -tx1 /dev/urandom | tr -d '[:space:]')" || return 1
  [[ "$work_id" =~ ^[0-9a-f]{32}$ ]] || return 1
  printf '%s\n' "$work_id"
}

worktree_plan_id() {
  local bind=false branch metadata_path recorded_branch recorded_path current_path work_id count tmp
  case "${1:-}" in
    '') ;;
    --bind) bind=true; shift ;;
    *) fail "unknown option for worktree plan-id: $1" ;;
  esac
  [[ $# -eq 0 ]] || fail "unexpected argument for worktree plan-id: $1"
  require_repo
  is_linked_worktree || fail "worktree plan-id requires a linked worktree"
  branch="$(branch_name)"
  [[ -n "$branch" ]] || fail "worktree plan-id requires a branch"
  metadata_path="$(validate_worktree_metadata_authority "$branch")" || return 1
  recorded_branch="$(sed -n 's/^- Branch: //p' "$metadata_path")"
  recorded_path="$(sed -n 's/^- Path: //p' "$metadata_path")"
  current_path="$(git rev-parse --show-toplevel)"
  [[ -d "$recorded_path" ]] || fail "worktree metadata path is unavailable"
  recorded_path="$(cd "$recorded_path" && pwd -P)"
  current_path="$(cd "$current_path" && pwd -P)"
  [[ "$recorded_branch" == "$branch" && "$recorded_path" == "$current_path" ]] \
    || fail "worktree metadata does not match this branch and path"
  count="$(grep -c '^- Work ID:' "$metadata_path" || true)"
  [[ "$count" -le 1 ]] || fail "worktree metadata has duplicate Work ID fields"
  work_id="$(sed -n 's/^- Work ID: //p' "$metadata_path")"
  if [[ -z "$work_id" && "$bind" == true && "$count" -eq 0 ]]; then
    work_id="$(new_work_id)" || fail "could not generate a work ID"
    tmp="$(mktemp "$(dirname "$metadata_path")/.plan-id.XXXXXX")" || fail "could not stage worktree metadata"
    if ! awk -v id="$work_id" '{print} /^- Created: / {print "- Work ID: " id}' "$metadata_path" >"$tmp"; then
      rm -f "$tmp"
      fail "could not bind worktree plan ID"
    fi
    if [[ "$(grep -c '^- Work ID:' "$tmp" || true)" -ne 1 ]]; then
      rm -f "$tmp"
      fail "worktree metadata has no unique Created field for plan ID binding"
    fi
    mv "$tmp" "$metadata_path" || fail "could not publish worktree plan ID"
  fi
  [[ "$work_id" =~ ^[0-9a-f]{32}$ ]] || fail "worktree metadata has no valid Work ID; use safe-git worktree plan-id --bind for legacy metadata"
  printf 'g-review-work-id: %s\n' "$work_id"
}

remove_worktree_metadata() {
  local branch="$1" metadata_path
  metadata_path="$(worktree_metadata_path "$branch")" || return 1
  rm -f "$metadata_path"
}

# True when the target hook is one safe-git manages: the current marker, or a
# pre-marker legacy safe-git hook — so a repo that copied the old hooks per the
# old README is upgraded to the new gate instead of being treated as foreign.
safe_git_hook_ours() {
  local target="$1" name="$2" marker="$3"
  grep -q "$marker" "$target" 2>/dev/null && return 0
  case "$name" in
    pre-push)   grep -q "Pushing to main/master is blocked" "$target" 2>/dev/null && return 0 ;;
    pre-commit) grep -q "Direct commit to" "$target" 2>/dev/null && return 0 ;;
  esac
  return 1
}

# Install/refresh safe-git's managed hooks into the repo's shared hooks dir
# (git-common-dir/hooks), which covers the main checkout and every linked
# worktree. Without this, the hooks ship in the skill but never deploy, so the
# main/master and ticket-receipt push gates are inert. Refresh only hooks we
# manage (marker or legacy signature); never clobber a pre-existing foreign hook.
# Non-fatal: a hook-install hiccup must not block worktree creation.
install_hooks() {
  local path="$1" common hooks_dir src name target
  local marker="safe-git-managed-hook"
  if [[ -z "${SAFE_GIT_HOOKS_DIR:-}" || ! -d "$SAFE_GIT_HOOKS_DIR" ]]; then
    printf 'safe-git: NOTE: canonical hooks dir not found; skipped hook install\n' >&2
    return 0
  fi
  # Only auto-install in the default hook layout (no core.hooksPath), where the
  # shared git-common-dir/hooks always lives OUTSIDE the worktree. Any
  # core.hooksPath — relative, absolute, or global — means the repo redirects
  # hooks, and the target may sit inside the worktree (dirtying it / risking a
  # committed guard hook) or govern unrelated repos. Don't try to be clever:
  # skip with one note and let the user install by hand.
  if [[ -n "$(cd "$path" 2>/dev/null && git config --get core.hooksPath 2>/dev/null || true)" ]]; then
    printf 'safe-git: NOTE: core.hooksPath is set; safe-git hooks not auto-installed. Install them by hand into your configured hooks dir.\n' >&2
    return 0
  fi
  common="$(cd "$path" 2>/dev/null && git rev-parse --git-common-dir 2>/dev/null)" || return 0
  hooks_dir="$(cd "$path" && cd "$common" && pwd)/hooks" || return 0
  mkdir -p "$hooks_dir" || return 0
  for src in "$SAFE_GIT_HOOKS_DIR"/*; do
    [[ -f "$src" ]] || continue
    name="$(basename "$src")"
    target="$hooks_dir/$name"
    if [[ -e "$target" ]] && ! safe_git_hook_ours "$target" "$name" "$marker"; then
      printf 'safe-git: NOTE: existing non-safe-git %s hook left untouched at %s\n' "$name" "$target" >&2
      continue
    fi
    cp "$src" "$target" && chmod +x "$target" \
      || printf 'safe-git: NOTE: could not install %s hook at %s\n' "$name" "$target" >&2
  done
}

normalize_absolute_path_lexically() {
  local path="$1" component
  if [[ "$path" != /* ]]; then
    path="$PWD/$path"
  fi

  local -a components normalized
  local remainder="$path"
  components=()
  while [[ "$remainder" == */* ]]; do
    components+=("${remainder%%/*}")
    remainder="${remainder#*/}"
  done
  components+=("$remainder")
  normalized=()
  for component in "${components[@]}"; do
    case "$component" in
      ""|.) ;;
      ..)
        if [[ ${#normalized[@]} -gt 0 ]]; then
          unset "normalized[$((${#normalized[@]} - 1))]"
        fi
        ;;
      *) normalized+=("$component") ;;
    esac
  done

  local IFS=/
  printf '/%s\n' "${normalized[*]}"
}

normalize_absolute_path() {
  local path="$1" resolved candidate suffix base
  if resolved="$(realpath -m -- "$path" 2>/dev/null)"; then
    printf '%s\n' "$resolved"
    return
  fi

  if [[ "$path" != /* ]]; then
    path="$PWD/$path"
  fi

  candidate="$path"
  suffix=""
  while [[ ! -e "$candidate" && "$candidate" != "/" ]]; do
    base="$(basename "$candidate")"
    suffix="/$base$suffix"
    candidate="$(dirname "$candidate")"
  done

  if [[ -d "$candidate" ]]; then
    resolved="$(cd "$candidate" && pwd -P)"
  elif [[ -e "$candidate" ]]; then
    resolved="$(cd "$(dirname "$candidate")" && pwd -P)/$(basename "$candidate")"
  else
    resolved="/"
  fi

  normalize_absolute_path_lexically "$resolved$suffix"
}

check_worktree_target_path() {
  local wt_path="$1" main_wt main_abs wt_abs safe_root
  main_wt="$(main_worktree_path)" || return 1

  main_abs="$(normalize_absolute_path "$main_wt")"
  wt_abs="$(normalize_absolute_path "$wt_path")"
  safe_root="$main_abs/.worktrees"

  case "$wt_abs" in
    "$main_abs"|"$main_abs"/*)
      case "$wt_abs" in
        "$safe_root"/*) ;;
        *)
          fail "worktree path resolves inside the main checkout. Use .worktrees/<task> or a path outside the main checkout."
          ;;
      esac
      ;;
  esac
}

# When run from a subdirectory of the main checkout, a relative path like
# `.worktrees/<slug>` resolves under CWD rather than the repo root. Re-root
# it at the repo root so the canonical form works from any CWD within the
# main checkout. Only rewrites paths that would otherwise be blocked (inside
# the main checkout but not under its .worktrees/); all other paths pass through.
normalize_worktree_path() {
  local wt_path="$1"
  if [[ "$wt_path" == *$'\n'* ]]; then
    fail "worktree paths containing newlines are not supported"
  fi
  [[ "$wt_path" == /* ]] && printf '%s\n' "$wt_path" && return
  local main_wt main_abs wt_abs safe_root rerooted
  main_wt="$(main_worktree_path)" || return 1
  main_abs="$(normalize_absolute_path "$main_wt")"
  wt_abs="$(normalize_absolute_path "$wt_path")"
  safe_root="$main_abs/.worktrees"
  case "$wt_abs" in
    "$main_abs"|"$main_abs"/*)
      case "$wt_abs" in
        "$safe_root"/*) ;;
        *)
          rerooted="$(normalize_absolute_path "$main_abs/$wt_path")"
          [[ "$rerooted" == "$safe_root"/* ]] && { printf '%s\n' "$rerooted"; return; }
          ;;
      esac
      ;;
  esac
  printf '%s\n' "$wt_path"
}

worktree_start() {
  local wt_path="" branch="" base_ref="" purpose="" issue="" title="" no_fetch=false ticket_source=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -b|--branch)
        require_value "$1" "${2:-}"
        branch="$2"
        shift 2
        ;;
      --base)
        require_value "$1" "${2:-}"
        base_ref="$2"
        shift 2
        ;;
      --purpose)
        require_value "$1" "${2:-}"
        purpose="$2"
        shift 2
        ;;
      --issue)
        require_value "$1" "${2:-}"
        issue="$2"
        shift 2
        ;;
      --title)
        require_value "$1" "${2:-}"
        title="$2"
        shift 2
        ;;
      --ticket-source)
        require_value "$1" "${2:-}"
        ticket_source="$2"
        shift 2
        ;;
      --no-fetch)
        no_fetch=true
        shift
        ;;
      -*)
        fail "unknown option for worktree start: $1"
        ;;
      *)
        if [[ -n "$wt_path" ]]; then
          fail "unexpected argument for worktree start: $1"
        fi
        wt_path="$1"
        shift
        ;;
    esac
  done

  [[ -n "$wt_path" ]] || fail "worktree path is required"
  [[ -n "$branch" ]] || fail "--branch is required"
  [[ -n "$purpose" ]] || fail "--purpose is required"
  if [[ -n "$ticket_source" ]] && [[ "$ticket_source" != "github" && "$ticket_source" != "local" ]]; then
    fail "--ticket-source must be github or local"
  fi

  require_repo
  check_clean_state
  if is_linked_worktree; then
    fail "current checkout is already a linked worktree; use safe-git worktree start from the main worktree for new branches"
  fi
  if ! "$no_fetch"; then
    fetch_remotes
  fi
  if [[ -z "$base_ref" ]]; then
    base_ref="$(default_base_ref)"
  fi
  git rev-parse --verify --quiet "$base_ref" >/dev/null \
    || fail "base ref $base_ref does not exist"
  # Pin the recorded base to an immutable commit SHA. A symbolic base
  # (e.g. `HEAD`, `--base HEAD`) would otherwise resolve to the feature
  # branch's current tip at cleanup time, making `git rev-list --count
  # <base>..HEAD` report 0 even after implementation commits were added,
  # so check plan-done would delete the branch and its commits.
  local base_sha work_id
  base_sha="$(git rev-parse --verify --quiet "$base_ref^{commit}")" \
    || fail "base ref $base_ref is not a commit"
  work_id="$(new_work_id)" || fail "could not generate a work ID"

  wt_path="$(normalize_worktree_path "$wt_path")"
  check_worktree_target_path "$wt_path"
  git worktree add "$wt_path" -b "$branch" "$base_ref" \
    || fail "git worktree add $wt_path -b $branch $base_ref failed"
  write_worktree_metadata "$wt_path" "$branch" "$base_sha" "$purpose" "$issue" "$title" "$ticket_source" \
    "Created worktree from $base_ref." "$work_id"
  install_hooks "$wt_path"
  ok "worktree $wt_path created for $branch; description recorded at $(worktree_metadata_path "$branch")"
}

worktree_adopt() {
  local wt_path="" purpose="" issue="" title="" base_ref="" no_fetch=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --base)
        require_value "$1" "${2:-}"
        base_ref="$2"
        shift 2
        ;;
      --purpose)
        require_value "$1" "${2:-}"
        purpose="$2"
        shift 2
        ;;
      --issue)
        require_value "$1" "${2:-}"
        issue="$2"
        shift 2
        ;;
      --title)
        require_value "$1" "${2:-}"
        title="$2"
        shift 2
        ;;
      --no-fetch)
        no_fetch=true
        shift
        ;;
      -*)
        fail "unknown option for worktree adopt: $1"
        ;;
      *)
        if [[ -n "$wt_path" ]]; then
          fail "unexpected argument for worktree adopt: $1"
        fi
        wt_path="$1"
        shift
        ;;
    esac
  done

  [[ -n "$wt_path" ]] || fail "worktree path is required"
  [[ -n "$purpose" ]] || fail "--purpose is required"

  require_repo
  check_clean_state
  check_worktree_clean
  if ! is_main_worktree; then
    fail "current checkout is already a linked worktree; use safe-git worktree start from the main worktree for new branches"
  fi

  local branch default_branch default_ref work_id
  branch="$(branch_name)"
  [[ -n "$branch" ]] || fail "detached HEAD; switch to the branch you want to adopt"
  if is_main_branch "$branch"; then
    fail "current branch is $branch; switch to a feature branch before adopting it into a worktree"
  fi
  work_id="$(new_work_id)" || fail "could not generate a work ID"

  if ! "$no_fetch"; then
    fetch_remotes
  fi
  check_freshness

  if [[ -n "$base_ref" ]]; then
    git rev-parse --verify --quiet "$base_ref" >/dev/null \
      || fail "base ref $base_ref does not exist"
    default_branch="$(ref_to_local_branch "$base_ref")"
    default_ref="$base_ref"
  else
    default_branch="$(default_branch_name)"
    default_ref="origin/$default_branch"
    git rev-parse --verify --quiet "$default_ref" >/dev/null \
      || fail "default base $default_ref does not exist"
  fi
  git rev-parse --verify --quiet "$default_branch" >/dev/null \
    || fail "local default branch $default_branch does not exist"

  wt_path="$(normalize_worktree_path "$wt_path")"
  check_worktree_target_path "$wt_path"
  git checkout "$default_branch" \
    || fail "could not switch main worktree to $default_branch; resolve manually"
  local adoption_error=""
  if ! git merge --ff-only "$default_ref"; then
    adoption_error="could not fast-forward $default_branch to $default_ref"
  elif ! git worktree add "$wt_path" "$branch"; then
    adoption_error="git worktree add $wt_path $branch failed"
  fi
  if [[ -n "$adoption_error" ]]; then
    # Restore the caller's checkout, retaining any completed default fast-forward.
    git checkout "$branch" \
      || fail "$adoption_error; could not restore checkout to $branch; inspect git status and resolve manually before running: git checkout $branch"
    fail "$adoption_error; restored checkout to $branch. Resolve the failure before retrying adoption."
  fi
  write_worktree_metadata "$wt_path" "$branch" "existing branch" "$purpose" "$issue" "$title" "" "Moved existing branch from main worktree." "$work_id"
  install_hooks "$wt_path"
  ok "worktree $wt_path created for existing branch $branch; description recorded at $(worktree_metadata_path "$branch")"
}

main() {
  case "${1:-}" in
    check)
      case "${2:-}" in
        start) shift 2; check_start "$@" ;;
        pr) shift 2; check_pr "$@" ;;
        done) shift 2; check_done "$@" ;;
        plan-done) shift 2; check_plan_done "$@" ;;
        *) usage; exit 2 ;;
      esac
      ;;
    worktree)
      case "${2:-}" in
        start) shift 2; worktree_start "$@" ;;
        adopt) shift 2; worktree_adopt "$@" ;;
        plan-id) shift 2; worktree_plan_id "$@" ;;
        *) usage; exit 2 ;;
      esac
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

main "$@"
